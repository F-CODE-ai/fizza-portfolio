# Copy this file to .env and fill in values LOCALLY. Never commit .env, never paste values in chat.
# On Vercel, add the same NAMES under Project > Settings > Environment Variables.

# --- site ---
SITE_ORIGINS=http://localhost:5173,http://localhost:4173

# --- Supabase (server only; service role key must never reach the browser) ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Cloudflare Turnstile ---
VITE_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- secrets for HMAC (time-trap, chat token) and IP hashing: long random strings ---
FORM_HMAC_SECRET=
CHAT_HMAC_SECRET=
IP_HASH_SALT=

# --- email (Gmail SMTP with an App Password) ---
GMAIL_USER=
GMAIL_APP_PASSWORD=
CONTACT_TO=

# --- AI providers ---
GEMINI_API_KEY=
GROQ_API_KEY=
